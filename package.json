    "test:release-config": "tsx src/test/release-config.test.ts",
    "test:unit": "tsx src/test/unit/domain-and-services.unit.test.ts",
    "test:service-integration": "tsx src/test/integration/service-repository.integration.test.ts",
    "test:http": "tsx src/test/http/http-contracts-and-security.test.ts",
    "test:api": "tsx src/test/api.test.ts",
    "test:auth": "tsx src/test/auth.test.ts",
    "test:authorization": "tsx src/test/authorization.test.ts",
    "test:relationships": "tsx src/test/relationships.test.ts",
    "test:pagination": "tsx src/test/pagination.test.ts",
    "test:security": "tsx src/test/security.test.ts",
    "test:observability": "tsx src/test/observability.test.ts",
    "test:scaling": "tsx src/test/scaling.test.ts",
    "test:docker": "tsx src/test/docker-runtime.test.ts",
    "test:deploy": "tsx src/test/deployment.test.ts",
    "test:docs": "tsx src/test/developer-readiness.test.ts",
    "test:validation": "tsx src/test/validation.test.ts",
    "test:integration": "tsx src/test/postgres.test.ts",
    "test:all": "npm test && npm run test:integration && npm run test:scaling && npm run test:docker && npm run test:deploy && npm run test:docs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
