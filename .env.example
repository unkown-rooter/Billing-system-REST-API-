# ============================================================================
# Billing System REST API — Environment Configuration Template (.env.example)
# ============================================================================
# SECURITY NOTE — DEVELOPMENT-ONLY PLACEHOLDERS:
# All sample credentials in this template (`username:password`, `MY_JWT_SECRET`, etc.)
# are DEVELOPMENT-ONLY placeholders. Never commit `.env` files or real credentials.
# In `NODE_ENV="production"`, startup fails closed (`SecurityConfigurationError`)
# if `DATABASE_URL` or `JWT_SECRET` is missing, weak (< 32 chars), or set to a
# development-only fallback/placeholder value.
# ============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string.
# DEVELOPMENT-ONLY example placeholder below. In production, inject a strong credential via Secret Manager.
DATABASE_URL="postgresql://username:password@localhost:5432/billing_system"

# JWT_SECRET: Cryptographic key for signing JWT tokens (HMAC-SHA256).
# DEVELOPMENT-ONLY placeholder below. In production, must be >= 32 characters and non-placeholder (fails closed).
JWT_SECRET="MY_JWT_SECRET"

# JWT_EXPIRES_IN: Token expiration window in seconds (finite positive integer 1..2592000). Default is 86400 (24 hours).
JWT_EXPIRES_IN="86400"

# RATE_LIMIT_MODE: Rate limiter enforcement mode ('process_local' | 'edge_enforced' | 'shared_store').
# Default 'process_local' uses a bounded per-process in-memory store (not global across multi-instance replicas).
# For multi-instance Cloud Run deployments, pair with an edge/API gateway limiter ('edge_enforced') or shared store.
RATE_LIMIT_MODE="process_local"

# AUTH_RATE_LIMIT_WINDOW_MS: Rate limit window in milliseconds for /api/v1/auth/login and /register. Default is 60000 (60s).
AUTH_RATE_LIMIT_WINDOW_MS="60000"

# AUTH_RATE_LIMIT_MAX: Maximum authentication attempts per window per client IP (per instance unless shared/edge limiter is used). Default is 30.
AUTH_RATE_LIMIT_MAX="30"

# API_RATE_LIMIT_WINDOW_MS: Rate limit window in milliseconds for general /api/v1/* endpoints. Default is 60000 (60s).
API_RATE_LIMIT_WINDOW_MS="60000"

# API_RATE_LIMIT_MAX: Maximum API requests per window per client IP (per instance unless shared/edge limiter is used). Default is 300.
API_RATE_LIMIT_MAX="300"

# CORS_ALLOWED_ORIGINS: Comma-separated list of explicitly trusted origins allowed for browser CORS requests.
# Leave empty to disallow cross-origin browser requests by default. Never use '*' with credentials.
CORS_ALLOWED_ORIGINS=""

# ENABLE_HSTS: Set to "true" to emit Strict-Transport-Security header outside NODE_ENV="production".
ENABLE_HSTS="false"

# TRUST_PROXY: Set to "1" or "true" when deployed behind a TLS-terminating reverse proxy (e.g., Google Cloud Run).
TRUST_PROXY="1"

# LOG_LEVEL: Minimum structured log severity level ('debug' | 'info' | 'warn' | 'error').
# Defaults to 'info'. Note: 'debug' is automatically clamped to 'info' when NODE_ENV="production".
LOG_LEVEL="info"

# DB_POOL_MAX: Maximum PostgreSQL connections per API instance (`N instances * DB_POOL_MAX < max_connections`). Default is 10.
DB_POOL_MAX="10"

# DB_POOL_IDLE_TIMEOUT_MS: Milliseconds an idle PostgreSQL client remains in the pool before closing. Default is 30000 (30s).
DB_POOL_IDLE_TIMEOUT_MS="30000"

# DB_POOL_CONNECTION_TIMEOUT_MS: Milliseconds to wait for an available PostgreSQL connection before failing. Default is 5000 (5s).
DB_POOL_CONNECTION_TIMEOUT_MS="5000"

# DB_STATEMENT_TIMEOUT_MS: Per-statement execution timeout in milliseconds to prevent runaway queries from starving the pool. Default is 10000 (10s).
DB_STATEMENT_TIMEOUT_MS="10000"

# HTTP_KEEP_ALIVE_TIMEOUT_MS: HTTP server keep-alive timeout in milliseconds (set > 60s load-balancer idle timeout to prevent 502 races). Default is 65000.
HTTP_KEEP_ALIVE_TIMEOUT_MS="65000"

# HTTP_HEADERS_TIMEOUT_MS: Maximum time in milliseconds to receive complete HTTP request headers. Default is 66000.
HTTP_HEADERS_TIMEOUT_MS="66000"

# HTTP_REQUEST_TIMEOUT_MS: Maximum time in milliseconds for an entire HTTP request. Default is 30000.
HTTP_REQUEST_TIMEOUT_MS="30000"


